{
  "name": "snip",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @snip/web dev",
    "build": "pnpm --filter @snip/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @snip/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:types": "supabase gen types typescript --local > apps/web/src/lib/database.types.ts"
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  }
}
